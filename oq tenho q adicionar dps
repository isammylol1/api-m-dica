    nome = mapped_column(String(50), nullable=False)
    email = mapped_column(String(50), unique=True)
    respostas = relationship("RespostaAnamnese", back_populates="paciente")

class RespostaAnamnese(Base):
    __tablename__ = "RespostaAnamnese"
    id = mapped_column(Integer, primary_key=True)
    paciente_id = mapped_column(Integer, ForeignKey("Paciente.id"), nullable=False)
    anamnese_id = mapped_column(Integer, nullable=False)
    paciente = relationship("Paciente", back_populates="respostas")

